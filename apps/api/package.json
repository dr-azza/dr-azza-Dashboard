{
  "name": "@azza/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test:integration": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run test/integration",
    "bundle:serverless": "node scripts/bundle-serverless.mjs"
  },
  "dependencies": {
    "@azza/shared": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-fastify": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "fastify": "^5.12.7",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.18.1",
    "swagger-ui-dist": "5.34.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@azza/tsconfig": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.20",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
