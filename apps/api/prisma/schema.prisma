// AZZAH clinical data model.
//
// Conventions:
// - Every clinical record belongs to a clinic (tenant), so the platform can grow from one
//   clinic to a network of doctors without a data migration.
// - IDs are UUIDv7 (time-ordered: index-friendly and not guessable).
// - Tables and columns are snake_case in Postgres, camelCase in TypeScript.
// - Timestamps are timestamptz.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy and staff
// ---------------------------------------------------------------------------

model Clinic {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  timezone  String   @default("Africa/Cairo")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  staff         StaffMember[]
  patients      Patient[]
  formTemplates FormTemplate[]
  reminders     Reminder[]
  auditLogs     AuditLog[]

  @@map("clinics")
}

enum StaffRole {
  OWNER
  DOCTOR
  NURSE
  RECEPTION

  @@map("staff_role")
}

model StaffMember {
  id           String    @id @default(uuid(7)) @db.Uuid
  clinicId     String    @map("clinic_id") @db.Uuid
  email        String
  fullName     String    @map("full_name")
  role         StaffRole
  /// Argon2id hash; null until the invite is accepted.
  passwordHash String?   @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic          Clinic         @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  visits          Visit[]
  reviewedAnswers FormResponse[]
  sessions        Session[]
  prescriptions   Prescription[]
  payments        Payment[]
  attachments     Attachment[]
  notes           ClinicalNote[]

  @@unique([clinicId, email])
  @@map("staff_members")
}

// ---------------------------------------------------------------------------
// Patients and clinical follow-up
// ---------------------------------------------------------------------------

enum CaseType {
  PREGNANCY
  GYNECOLOGY
  POSTPARTUM
  FERTILITY

  @@map("case_type")
}

enum PatientStatus {
  OK
  FLAGGED
  OVERDUE
  AWAITING

  @@map("patient_status")
}

model Patient {
  id          String        @id @default(uuid(7)) @db.Uuid
  clinicId    String        @map("clinic_id") @db.Uuid
  /// Clinic-facing file number, e.g. "P-1187". Unique within a clinic.
  fileNumber  String        @map("file_number")
  fullName    String        @map("full_name")
  /// Name as written in Arabic, when it differs from the Latin spelling.
  fullNameAr  String?       @map("full_name_ar")
  dateOfBirth DateTime?     @map("date_of_birth") @db.Date
  /// E.164 format, e.g. +201012344410.
  phone       String
  caseType    CaseType      @map("case_type")
  status      PatientStatus @default(OK)
  /// Consent to store and process health data, required before any form is sent.
  consentAt   DateTime?     @map("consent_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Soft delete: medical records are retained, never hard-deleted by the app.
  archivedAt  DateTime?     @map("archived_at") @db.Timestamptz(3)

  clinic           Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  pregnancies      Pregnancy[]
  visits           Visit[]
  formRequests     FormRequest[]
  reminders        Reminder[]
  medicalHistory   MedicalHistory?
  obstetricHistory ObstetricHistoryEntry[]
  prescriptions    Prescription[]
  payments         Payment[]
  attachments      Attachment[]
  notes            ClinicalNote[]

  @@unique([clinicId, fileNumber])
  @@index([clinicId, status])
  @@index([clinicId, caseType])
  @@map("patients")
}

enum PregnancyStatus {
  ACTIVE
  DELIVERED
  ENDED

  @@map("pregnancy_status")
}

model Pregnancy {
  id          String          @id @default(uuid(7)) @db.Uuid
  patientId   String          @map("patient_id") @db.Uuid
  /// First day of the last menstrual period; gestational age and EDD derive from it (@azza/shared).
  lmp         DateTime        @db.Date
  /// Set only when a dating scan corrects the LMP-based due date.
  eddOverride DateTime?       @map("edd_override") @db.Date
  gravida     Int?
  para        Int?
  bloodGroup  String?         @map("blood_group")
  riskNotes   String?         @map("risk_notes")
  status      PregnancyStatus @default(ACTIVE)
  endedAt     DateTime?       @map("ended_at") @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visits  Visit[]

  @@index([patientId, status])
  @@map("pregnancies")
}

model Visit {
  id              String   @id @default(uuid(7)) @db.Uuid
  patientId       String   @map("patient_id") @db.Uuid
  pregnancyId     String?  @map("pregnancy_id") @db.Uuid
  recordedById    String?  @map("recorded_by_id") @db.Uuid
  visitedAt       DateTime @map("visited_at") @db.Timestamptz(3)
  weightKg        Decimal? @map("weight_kg") @db.Decimal(5, 2)
  systolic        Int?
  diastolic       Int?
  fundalHeightCm  Decimal? @map("fundal_height_cm") @db.Decimal(4, 1)
  fetalHeartRate  Int?     @map("fetal_heart_rate")
  notes           String?
  /// True for readings the patient reported herself (e.g. home BP from a form).
  isPatientReport Boolean  @default(false) @map("is_patient_report")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  patient    Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  pregnancy  Pregnancy?   @relation(fields: [pregnancyId], references: [id], onDelete: SetNull)
  recordedBy StaffMember? @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([patientId, visitedAt(sort: Desc)])
  @@map("visits")
}

// ---------------------------------------------------------------------------
// Forms sent to patients by link
// ---------------------------------------------------------------------------

model FormTemplate {
  id        String   @id @default(uuid(7)) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  /// Stable key used by code, e.g. "weekly-checkin".
  key       String
  /// Bilingual name: { en, ar }.
  name      Json
  /// Question definitions (versioned JSON), validated by the API.
  schema    Json
  version   Int      @default(1)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic   Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  requests FormRequest[]

  @@unique([clinicId, key, version])
  @@map("form_templates")
}

enum Channel {
  WHATSAPP
  SMS
  LINK

  @@map("channel")
}

/// One private link sent to one patient for one form.
model FormRequest {
  id         String    @id @default(uuid(7)) @db.Uuid
  templateId String    @map("template_id") @db.Uuid
  patientId  String    @map("patient_id") @db.Uuid
  /// SHA-256 of the link token. The raw token only ever exists in the link itself.
  tokenHash  String    @unique @map("token_hash")
  channel    Channel
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  sentAt     DateTime? @map("sent_at") @db.Timestamptz(3)
  openedAt   DateTime? @map("opened_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  template FormTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  patient  Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  response FormResponse?

  @@index([patientId, createdAt(sort: Desc)])
  @@map("form_requests")
}

model FormResponse {
  id           String    @id @default(uuid(7)) @db.Uuid
  requestId    String    @unique @map("request_id") @db.Uuid
  answers      Json
  /// Set by the API using the shared clinical rules (@azza/shared), never by the client.
  isFlagged    Boolean   @default(false) @map("is_flagged")
  flagReasons  String[]  @map("flag_reasons")
  submittedAt  DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(3)
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewedById String?   @map("reviewed_by_id") @db.Uuid

  request    FormRequest  @relation(fields: [requestId], references: [id], onDelete: Restrict)
  reviewedBy StaffMember? @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([isFlagged, reviewedAt])
  @@map("form_responses")
}

// ---------------------------------------------------------------------------
// Reminders and audit
// ---------------------------------------------------------------------------

enum DeliveryStatus {
  QUEUED
  SENT
  FAILED
  CANCELLED

  @@map("delivery_status")
}

model Reminder {
  id           String         @id @default(uuid(7)) @db.Uuid
  clinicId     String         @map("clinic_id") @db.Uuid
  patientId    String?        @map("patient_id") @db.Uuid
  /// e.g. "appointment", "form", "medication", "test-due".
  kind         String
  channel      Channel
  scheduledFor DateTime       @map("scheduled_for") @db.Timestamptz(3)
  status       DeliveryStatus @default(QUEUED)
  payload      Json
  sentAt       DateTime?      @map("sent_at") @db.Timestamptz(3)
  error        String?
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  clinic  Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor])
  @@index([clinicId, scheduledFor])
  @@map("reminders")
}

/// Append-only record of who read or changed what. Required for medical data.
model AuditLog {
  id       BigInt   @id @default(autoincrement())
  clinicId String?  @map("clinic_id") @db.Uuid
  actorId  String?  @map("actor_id") @db.Uuid
  /// e.g. "patient.view", "visit.create", "form.submit".
  action   String
  entity   String
  entityId String?  @map("entity_id")
  ip       String?
  meta     Json?
  at       DateTime @default(now()) @db.Timestamptz(3)

  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@index([clinicId, at(sort: Desc)])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Authentication
// ---------------------------------------------------------------------------

/// A signed-in staff session. The token lives only in the client's httpOnly cookie
/// (or bearer header for the mobile app); the database keeps its SHA-256 hash.
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  staffId    String    @map("staff_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Medical history
// ---------------------------------------------------------------------------

/// One per patient: general, gynecological and obstetric summary. Upserted as a whole.
model MedicalHistory {
  patientId String @id @map("patient_id") @db.Uuid

  // General
  /// [{ substance, reaction?, severity: "mild" | "moderate" | "severe" }]
  allergies          Json     @default("[]")
  chronicConditions  String[] @map("chronic_conditions")
  currentMedications String[] @map("current_medications")
  /// [{ name, year? }]
  surgeries          Json     @default("[]")
  bloodGroup         String?  @map("blood_group")
  familyHistory      String?  @map("family_history")
  smoking            Boolean?

  // Gynecological
  menarcheAge        Int?      @map("menarche_age")
  cycleLengthDays    Int?      @map("cycle_length_days")
  periodLengthDays   Int?      @map("period_length_days")
  cycleRegular       Boolean?  @map("cycle_regular")
  contraception      String?
  lastPapSmearAt     DateTime? @map("last_pap_smear_at") @db.Date
  lastPapSmearResult String?   @map("last_pap_smear_result")
  gynNotes           String?   @map("gyn_notes")

  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?  @map("updated_by_id") @db.Uuid

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@map("medical_histories")
}

enum PregnancyOutcome {
  LIVE_BIRTH
  STILLBIRTH
  MISCARRIAGE
  ECTOPIC
  TERMINATION
  MOLAR

  @@map("pregnancy_outcome")
}

enum DeliveryMode {
  VAGINAL
  ASSISTED
  CESAREAN

  @@map("delivery_mode")
}

/// A previous pregnancy. Gravida/para are derived from these entries.
model ObstetricHistoryEntry {
  id             String           @id @default(uuid(7)) @db.Uuid
  patientId      String           @map("patient_id") @db.Uuid
  year           Int?
  outcome        PregnancyOutcome
  deliveryMode   DeliveryMode?    @map("delivery_mode")
  gestationWeeks Int?             @map("gestation_weeks")
  birthWeightG   Int?             @map("birth_weight_g")
  complications  String?
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@map("obstetric_history_entries")
}

// ---------------------------------------------------------------------------
// Prescriptions
// ---------------------------------------------------------------------------

model Prescription {
  id             String    @id @default(uuid(7)) @db.Uuid
  patientId      String    @map("patient_id") @db.Uuid
  prescribedById String?   @map("prescribed_by_id") @db.Uuid
  /// Human-friendly number printed on the prescription, e.g. "RX-2026-00042".
  number         String
  issuedAt       DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  diagnosis      String?
  notes          String?
  /// Prescriptions are never edited once issued; a mistake is voided and a new one issued.
  voidedAt       DateTime? @map("voided_at") @db.Timestamptz(3)
  voidReason     String?   @map("void_reason")

  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  prescribedBy StaffMember?       @relation(fields: [prescribedById], references: [id], onDelete: SetNull)
  items        PrescriptionItem[]

  @@unique([patientId, number])
  @@index([patientId, issuedAt(sort: Desc)])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String  @id @default(uuid(7)) @db.Uuid
  prescriptionId String  @map("prescription_id") @db.Uuid
  position       Int
  drugName       String  @map("drug_name")
  /// e.g. "5 mg", "1 tablet"
  dose           String?
  /// e.g. "Once daily", "Every 8 hours"
  frequency      String?
  /// e.g. "30 days", "Until delivery"
  duration       String?
  instructions   String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@unique([prescriptionId, position])
  @@map("prescription_items")
}

// ---------------------------------------------------------------------------
// Payments and files
// ---------------------------------------------------------------------------

enum PaymentMethod {
  CASH
  INSTAPAY
  VODAFONE_CASH
  CARD
  BANK_TRANSFER
  OTHER

  @@map("payment_method")
}

model Payment {
  id           String        @id @default(uuid(7)) @db.Uuid
  patientId    String        @map("patient_id") @db.Uuid
  receivedById String?       @map("received_by_id") @db.Uuid
  /// Money is stored as Decimal, never float.
  amount       Decimal       @db.Decimal(12, 2)
  currency     String        @default("EGP") @db.Char(3)
  method       PaymentMethod
  /// What it was for, e.g. "Consultation", "Ultrasound".
  purpose      String
  reference    String?
  paidAt       DateTime      @map("paid_at") @db.Timestamptz(3)
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt     DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidReason   String?       @map("void_reason")

  patient    Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  receivedBy StaffMember? @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  proofs     Attachment[]

  @@index([patientId, paidAt(sort: Desc)])
  @@map("payments")
}

enum AttachmentKind {
  PAYMENT_PROOF
  LAB_RESULT
  SCAN
  REPORT
  PRESCRIPTION_SCAN
  OTHER

  @@map("attachment_kind")
}

/// An uploaded file. Bytes live in object storage under `storageKey`, never in the database.
model Attachment {
  id           String         @id @default(uuid(7)) @db.Uuid
  patientId    String         @map("patient_id") @db.Uuid
  uploadedById String?        @map("uploaded_by_id") @db.Uuid
  paymentId    String?        @map("payment_id") @db.Uuid
  kind         AttachmentKind
  title        String
  fileName     String         @map("file_name")
  mimeType     String         @map("mime_type")
  sizeBytes    Int            @map("size_bytes")
  sha256       String
  storageKey   String         @unique @map("storage_key")
  /// When the lab test or scan was done, if different from the upload date.
  takenAt      DateTime?      @map("taken_at") @db.Date
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(3)

  patient    Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  uploadedBy StaffMember? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  payment    Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([patientId, kind, createdAt(sort: Desc)])
  @@map("attachments")
}

model ClinicalNote {
  id        String   @id @default(uuid(7)) @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  authorId  String?  @map("author_id") @db.Uuid
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  patient Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  author  StaffMember? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([patientId, createdAt(sort: Desc)])
  @@map("clinical_notes")
}
