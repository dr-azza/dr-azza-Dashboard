// AZZAH clinical data model.
//
// Conventions:
// - Every clinical record belongs to a clinic (tenant), so the platform can grow from one
//   clinic to a network of doctors without a data migration.
// - IDs are UUIDv7 (time-ordered: index-friendly and not guessable).
// - Tables and columns are snake_case in Postgres, camelCase in TypeScript.
// - Timestamps are timestamptz.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy and staff
// ---------------------------------------------------------------------------

model Clinic {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  timezone  String   @default("Africa/Cairo")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  staff             StaffMember[]
  patients          Patient[]
  forms             Form[]
  formResponses     FormResponse[]
  reminders         Reminder[]
  auditLogs         AuditLog[]
  caseTypes         CaseType[]
  appointments      Appointment[]
  tasks             Task[]
  financeCategories FinanceCategory[]
  financeEntries    FinanceEntry[]
  recurringExpenses RecurringExpense[]

  @@map("clinics")
}

enum StaffRole {
  OWNER
  DOCTOR
  NURSE
  RECEPTION

  @@map("staff_role")
}

model StaffMember {
  id           String    @id @default(uuid(7)) @db.Uuid
  clinicId     String    @map("clinic_id") @db.Uuid
  /// Lower-case; unique across clinics because sign-in is by email alone.
  email        String    @unique
  fullName     String    @map("full_name")
  /// E.164, optional.
  phone        String?
  role         StaffRole
  /// Argon2id hash; null until the invite is accepted.
  passwordHash String?   @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic                Clinic             @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  visits                Visit[]
  reviewedAnswers       FormResponse[]     @relation("FormResponseReviewer")
  linkedAnswers         FormResponse[]     @relation("FormResponseLinker")
  formsCreated          Form[]             @relation("FormCreator")
  formsUpdated          Form[]             @relation("FormUpdater")
  formVersions          FormVersion[]
  formLinks             FormLink[]
  sessions              Session[]
  prescriptions         Prescription[]
  payments              Payment[]
  attachments           Attachment[]
  notes                 ClinicalNote[]
  historyWritten        HistoryEntry[]     @relation("HistoryAuthor")
  historyEdited         HistoryEntry[]     @relation("HistoryEditor")
  appointmentsAssigned  Appointment[]      @relation("AppointmentAssignee")
  appointmentsCreated   Appointment[]      @relation("AppointmentCreator")
  tasksAssigned         Task[]             @relation("TaskAssignee")
  tasksCreated          Task[]             @relation("TaskCreator")
  tasksCompleted        Task[]             @relation("TaskCompleter")
  financeEntriesCreated FinanceEntry[]     @relation("FinanceEntryCreator")
  financeEntriesVoided  FinanceEntry[]     @relation("FinanceEntryVoider")
  financeReceipts       FinanceReceipt[]
  recurringExpenses     RecurringExpense[]
  invites               StaffInvite[]      @relation("InviteFor")
  invitesSent           StaffInvite[]      @relation("InviteSentBy")

  @@index([clinicId, fullName])
  @@map("staff_members")
}

/// File bytes kept in the database, for hosts without a lasting disk (STORAGE_DRIVER=database,
/// e.g. a free test deployment). Production uses an object store instead.
model StoredFile {
  key       String   @id
  bytes     Bytes
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("stored_files")
}

/// A one-time link to set a password: the first one when someone joins, or a reset later.
model StaffInvite {
  id          String    @id @default(uuid(7)) @db.Uuid
  staffId     String    @map("staff_id") @db.Uuid
  /// SHA-256 of the link token. The raw token only ever exists in the link itself.
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  /// Set when a newer link replaces this one, or the member is deactivated.
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  staff     StaffMember  @relation("InviteFor", fields: [staffId], references: [id], onDelete: Restrict)
  createdBy StaffMember? @relation("InviteSentBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([staffId, createdAt(sort: Desc)])
  @@map("staff_invites")
}

// ---------------------------------------------------------------------------
// Patients and clinical follow-up
// ---------------------------------------------------------------------------

/// Kinds of case a clinic follows (Pregnancy, Gynecology, …). Each clinic manages its own list.
/// Built-in cases carry a `systemKey` so the app can act on them (e.g. starting a pregnancy
/// moves the patient to the PREGNANCY case); cases the clinic adds have none.
model CaseType {
  id         String    @id @default(uuid(7)) @db.Uuid
  clinicId   String    @map("clinic_id") @db.Uuid
  nameEn     String    @map("name_en")
  nameAr     String    @map("name_ar")
  /// PREGNANCY | GYNECOLOGY | POSTPARTUM | FERTILITY for built-in cases, null for custom ones.
  systemKey  String?   @map("system_key")
  sortOrder  Int       @default(100) @map("sort_order")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic   Clinic    @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patients Patient[]

  @@unique([clinicId, nameEn])
  @@unique([clinicId, systemKey])
  @@index([clinicId, sortOrder])
  @@map("case_types")
}

enum PatientStatus {
  OK
  FLAGGED
  OVERDUE
  AWAITING

  @@map("patient_status")
}

/// How the patient is seen: at the clinic, or online (video or phone consultations).
enum PatientVisitMode {
  IN_CLINIC
  ONLINE

  @@map("patient_visit_mode")
}

model Patient {
  id          String           @id @default(uuid(7)) @db.Uuid
  clinicId    String           @map("clinic_id") @db.Uuid
  /// Clinic-facing file number, e.g. "P-1187". Unique within a clinic.
  fileNumber  String           @map("file_number")
  fullName    String           @map("full_name")
  /// Name as written in Arabic, when it differs from the Latin spelling.
  fullNameAr  String?          @map("full_name_ar")
  dateOfBirth DateTime?        @map("date_of_birth") @db.Date
  /// E.164 format, e.g. +201012344410.
  phone       String
  caseTypeId  String           @map("case_type_id") @db.Uuid
  status      PatientStatus    @default(OK)
  visitMode   PatientVisitMode @default(IN_CLINIC) @map("visit_mode")
  /// Consent to store and process health data, required before any form is sent.
  consentAt   DateTime?        @map("consent_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Soft delete: medical records are retained, never hard-deleted by the app.
  archivedAt  DateTime?        @map("archived_at") @db.Timestamptz(3)

  clinic           Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  caseType         CaseType                @relation(fields: [caseTypeId], references: [id], onDelete: Restrict)
  pregnancies      Pregnancy[]
  visits           Visit[]
  formLinks        FormLink[]
  formResponses    FormResponse[]
  reminders        Reminder[]
  medicalHistory   MedicalHistory?
  obstetricHistory ObstetricHistoryEntry[]
  prescriptions    Prescription[]
  payments         Payment[]
  attachments      Attachment[]
  notes            ClinicalNote[]
  historyEntries   HistoryEntry[]
  appointments     Appointment[]
  tasks            Task[]

  @@unique([clinicId, fileNumber])
  @@index([clinicId, status])
  @@index([clinicId, caseTypeId])
  @@map("patients")
}

enum PregnancyStatus {
  ACTIVE
  DELIVERED
  ENDED

  @@map("pregnancy_status")
}

model Pregnancy {
  id          String          @id @default(uuid(7)) @db.Uuid
  patientId   String          @map("patient_id") @db.Uuid
  /// First day of the last menstrual period; gestational age and EDD derive from it (@azza/shared).
  lmp         DateTime        @db.Date
  /// Set only when a dating scan corrects the LMP-based due date.
  eddOverride DateTime?       @map("edd_override") @db.Date
  gravida     Int?
  para        Int?
  bloodGroup  String?         @map("blood_group")
  riskNotes   String?         @map("risk_notes")
  status      PregnancyStatus @default(ACTIVE)
  endedAt     DateTime?       @map("ended_at") @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visits  Visit[]

  @@index([patientId, status])
  @@map("pregnancies")
}

model Visit {
  id              String   @id @default(uuid(7)) @db.Uuid
  patientId       String   @map("patient_id") @db.Uuid
  pregnancyId     String?  @map("pregnancy_id") @db.Uuid
  recordedById    String?  @map("recorded_by_id") @db.Uuid
  visitedAt       DateTime @map("visited_at") @db.Timestamptz(3)
  weightKg        Decimal? @map("weight_kg") @db.Decimal(5, 2)
  systolic        Int?
  diastolic       Int?
  fundalHeightCm  Decimal? @map("fundal_height_cm") @db.Decimal(4, 1)
  fetalHeartRate  Int?     @map("fetal_heart_rate")
  notes           String?
  /// True for readings the patient reported herself (e.g. home BP from a form).
  isPatientReport Boolean  @default(false) @map("is_patient_report")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  patient    Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  pregnancy  Pregnancy?   @relation(fields: [pregnancyId], references: [id], onDelete: SetNull)
  recordedBy StaffMember? @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([patientId, visitedAt(sort: Desc)])
  @@map("visits")
}

// ---------------------------------------------------------------------------
// Clinic-built forms, filled by patients through a link
// ---------------------------------------------------------------------------

enum Channel {
  WHATSAPP
  SMS
  LINK

  @@map("channel")
}

enum FormLanguage {
  ar
  en

  @@map("form_language")
}

/// How a response was tied to a patient.
enum FormResponseMatch {
  /// Submitted through the patient's personal link.
  LINK
  /// The phone typed on the shared link matched exactly one patient (unverified until reviewed).
  PHONE
  /// Linked by staff.
  STAFF

  @@map("form_response_match")
}

/// A form built by the clinic. `fields` is the current question list; every change to what
/// patients see is also kept as a FormVersion, so each response stays tied to the exact questions it answered.
model Form {
  id                 String       @id @default(uuid(7)) @db.Uuid
  clinicId           String       @map("clinic_id") @db.Uuid
  title              String
  description        String?
  language           FormLanguage @default(ar)
  /// Validated with FormFieldsSchema (@azza/shared) before it is stored.
  fields             Json
  version            Int          @default(1)
  /// Answerable questions (sections excluded), kept with `fields` so lists never load the JSON.
  questionCount      Int          @default(0) @map("question_count")
  /// Token of the shareable link (/f/:token). Public by design; rotating it retires old links.
  publicToken        String       @unique @map("public_token")
  acceptingResponses Boolean      @default(true) @map("accepting_responses")
  archivedAt         DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdById        String?      @map("created_by_id") @db.Uuid
  updatedById        String?      @map("updated_by_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic    Clinic         @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  createdBy StaffMember?   @relation("FormCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy StaffMember?   @relation("FormUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  versions  FormVersion[]
  links     FormLink[]
  responses FormResponse[]

  @@index([clinicId, updatedAt(sort: Desc)])
  @@map("forms")
}

/// Immutable snapshot of a form as patients saw it.
model FormVersion {
  id          String       @id @default(uuid(7)) @db.Uuid
  formId      String       @map("form_id") @db.Uuid
  version     Int
  title       String
  description String?
  language    FormLanguage
  fields      Json
  createdById String?      @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  form      Form           @relation(fields: [formId], references: [id], onDelete: Restrict)
  createdBy StaffMember?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  responses FormResponse[]

  @@unique([formId, version])
  @@map("form_versions")
}

/// A personal, single-use link to one form for one patient.
model FormLink {
  id          String    @id @default(uuid(7)) @db.Uuid
  formId      String    @map("form_id") @db.Uuid
  patientId   String    @map("patient_id") @db.Uuid
  /// SHA-256 of the link token. The raw token only ever exists in the link itself.
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  openedAt    DateTime? @map("opened_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  form      Form          @relation(fields: [formId], references: [id], onDelete: Restrict)
  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdBy StaffMember?  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  response  FormResponse?

  @@index([patientId, createdAt(sort: Desc)])
  @@map("form_links")
}

model FormResponse {
  id              String             @id @default(uuid(7)) @db.Uuid
  clinicId        String             @map("clinic_id") @db.Uuid
  formId          String             @map("form_id") @db.Uuid
  versionId       String             @map("version_id") @db.Uuid
  linkId          String?            @unique @map("link_id") @db.Uuid
  patientId       String?            @map("patient_id") @db.Uuid
  matchedBy       FormResponseMatch? @map("matched_by")
  /// Typed by the respondent on the shared link (personal links know the patient already).
  respondentName  String?            @map("respondent_name")
  respondentPhone String?            @map("respondent_phone")
  /// { [questionId]: answer }, validated and cleaned with validateAnswers (@azza/shared).
  answers         Json
  submittedAt     DateTime           @default(now()) @map("submitted_at") @db.Timestamptz(3)
  reviewedAt      DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  reviewedById    String?            @map("reviewed_by_id") @db.Uuid
  linkedById      String?            @map("linked_by_id") @db.Uuid

  clinic     Clinic       @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  form       Form         @relation(fields: [formId], references: [id], onDelete: Restrict)
  version    FormVersion  @relation(fields: [versionId], references: [id], onDelete: Restrict)
  link       FormLink?    @relation(fields: [linkId], references: [id], onDelete: Restrict)
  patient    Patient?     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  reviewedBy StaffMember? @relation("FormResponseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  linkedBy   StaffMember? @relation("FormResponseLinker", fields: [linkedById], references: [id], onDelete: SetNull)

  @@index([formId, submittedAt(sort: Desc)])
  @@index([patientId, submittedAt(sort: Desc)])
  @@index([clinicId, reviewedAt])
  @@index([clinicId, submittedAt(sort: Desc)])
  @@index([clinicId, patientId])
  @@map("form_responses")
}

// ---------------------------------------------------------------------------
// Reminders and audit
// ---------------------------------------------------------------------------

enum DeliveryStatus {
  QUEUED
  SENT
  FAILED
  CANCELLED

  @@map("delivery_status")
}

model Reminder {
  id           String         @id @default(uuid(7)) @db.Uuid
  clinicId     String         @map("clinic_id") @db.Uuid
  patientId    String?        @map("patient_id") @db.Uuid
  /// e.g. "appointment", "form", "medication", "test-due".
  kind         String
  channel      Channel
  scheduledFor DateTime       @map("scheduled_for") @db.Timestamptz(3)
  status       DeliveryStatus @default(QUEUED)
  payload      Json
  sentAt       DateTime?      @map("sent_at") @db.Timestamptz(3)
  error        String?
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  clinic  Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor])
  @@index([clinicId, scheduledFor])
  @@map("reminders")
}

/// Append-only record of who read or changed what. Required for medical data.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  clinicId  String?  @map("clinic_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  /// e.g. "patient.view", "visit.create", "form.submit".
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  /// The patient whose record this touched, if any: drives the patient's activity log.
  patientId String?  @map("patient_id") @db.Uuid
  ip        String?
  meta      Json?
  at        DateTime @default(now()) @db.Timestamptz(3)

  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@index([clinicId, at(sort: Desc)])
  @@index([entity, entityId])
  @@index([clinicId, patientId, id(sort: Desc)])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Authentication
// ---------------------------------------------------------------------------

/// A signed-in staff session. The token lives only in the client's httpOnly cookie
/// (or bearer header for the mobile app); the database keeps its SHA-256 hash.
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  staffId    String    @map("staff_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Medical history
// ---------------------------------------------------------------------------

/// One per patient: general, gynecological and obstetric summary. Upserted as a whole.
model MedicalHistory {
  patientId String @id @map("patient_id") @db.Uuid

  // General
  /// [{ substance, reaction?, severity: "mild" | "moderate" | "severe" }]
  allergies          Json     @default("[]")
  chronicConditions  String[] @map("chronic_conditions")
  currentMedications String[] @map("current_medications")
  /// [{ name, year? }]
  surgeries          Json     @default("[]")
  bloodGroup         String?  @map("blood_group")
  familyHistory      String?  @map("family_history")
  smoking            Boolean?

  // Gynecological
  menarcheAge        Int?      @map("menarche_age")
  cycleLengthDays    Int?      @map("cycle_length_days")
  periodLengthDays   Int?      @map("period_length_days")
  cycleRegular       Boolean?  @map("cycle_regular")
  contraception      String?
  lastPapSmearAt     DateTime? @map("last_pap_smear_at") @db.Date
  lastPapSmearResult String?   @map("last_pap_smear_result")
  gynNotes           String?   @map("gyn_notes")

  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?  @map("updated_by_id") @db.Uuid

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@map("medical_histories")
}

enum PregnancyOutcome {
  LIVE_BIRTH
  STILLBIRTH
  MISCARRIAGE
  ECTOPIC
  TERMINATION
  MOLAR

  @@map("pregnancy_outcome")
}

enum DeliveryMode {
  VAGINAL
  ASSISTED
  CESAREAN

  @@map("delivery_mode")
}

/// A previous pregnancy. Gravida/para are derived from these entries.
model ObstetricHistoryEntry {
  id             String           @id @default(uuid(7)) @db.Uuid
  patientId      String           @map("patient_id") @db.Uuid
  year           Int?
  outcome        PregnancyOutcome
  deliveryMode   DeliveryMode?    @map("delivery_mode")
  gestationWeeks Int?             @map("gestation_weeks")
  birthWeightG   Int?             @map("birth_weight_g")
  complications  String?
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@map("obstetric_history_entries")
}

// ---------------------------------------------------------------------------
// Prescriptions
// ---------------------------------------------------------------------------

model Prescription {
  id             String    @id @default(uuid(7)) @db.Uuid
  patientId      String    @map("patient_id") @db.Uuid
  prescribedById String?   @map("prescribed_by_id") @db.Uuid
  /// Human-friendly number printed on the prescription, e.g. "RX-2026-00042".
  number         String
  issuedAt       DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  diagnosis      String?
  notes          String?
  /// Prescriptions are never edited once issued; a mistake is voided and a new one issued.
  voidedAt       DateTime? @map("voided_at") @db.Timestamptz(3)
  voidReason     String?   @map("void_reason")

  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  prescribedBy StaffMember?       @relation(fields: [prescribedById], references: [id], onDelete: SetNull)
  items        PrescriptionItem[]

  @@unique([patientId, number])
  @@index([patientId, issuedAt(sort: Desc)])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String  @id @default(uuid(7)) @db.Uuid
  prescriptionId String  @map("prescription_id") @db.Uuid
  position       Int
  drugName       String  @map("drug_name")
  /// e.g. "5 mg", "1 tablet"
  dose           String?
  /// e.g. "Once daily", "Every 8 hours"
  frequency      String?
  /// e.g. "30 days", "Until delivery"
  duration       String?
  instructions   String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@unique([prescriptionId, position])
  @@map("prescription_items")
}

// ---------------------------------------------------------------------------
// Payments and files
// ---------------------------------------------------------------------------

enum PaymentMethod {
  CASH
  INSTAPAY
  VODAFONE_CASH
  CARD
  BANK_TRANSFER
  OTHER

  @@map("payment_method")
}

model Payment {
  id           String        @id @default(uuid(7)) @db.Uuid
  patientId    String        @map("patient_id") @db.Uuid
  receivedById String?       @map("received_by_id") @db.Uuid
  /// Money is stored as Decimal, never float.
  amount       Decimal       @db.Decimal(12, 2)
  currency     String        @default("EGP") @db.Char(3)
  method       PaymentMethod
  /// What it was for, e.g. "Consultation", "Ultrasound".
  purpose      String
  reference    String?
  paidAt       DateTime      @map("paid_at") @db.Timestamptz(3)
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt     DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidReason   String?       @map("void_reason")

  patient    Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  receivedBy StaffMember? @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  proofs     Attachment[]

  @@index([patientId, paidAt(sort: Desc)])
  @@map("payments")
}

enum AttachmentKind {
  PAYMENT_PROOF
  LAB_RESULT
  SCAN
  REPORT
  PRESCRIPTION_SCAN
  OTHER

  @@map("attachment_kind")
}

/// An uploaded file. Bytes live in object storage under `storageKey`, never in the database.
model Attachment {
  id           String         @id @default(uuid(7)) @db.Uuid
  patientId    String         @map("patient_id") @db.Uuid
  uploadedById String?        @map("uploaded_by_id") @db.Uuid
  paymentId    String?        @map("payment_id") @db.Uuid
  kind         AttachmentKind
  title        String
  fileName     String         @map("file_name")
  mimeType     String         @map("mime_type")
  sizeBytes    Int            @map("size_bytes")
  sha256       String
  storageKey   String         @unique @map("storage_key")
  /// When the lab test or scan was done, if different from the upload date.
  takenAt      DateTime?      @map("taken_at") @db.Date
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(3)

  patient    Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  uploadedBy StaffMember? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  payment    Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([patientId, kind, createdAt(sort: Desc)])
  @@map("attachments")
}

model ClinicalNote {
  id        String   @id @default(uuid(7)) @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  authorId  String?  @map("author_id") @db.Uuid
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  patient Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  author  StaffMember? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([patientId, createdAt(sort: Desc)])
  @@map("clinical_notes")
}

// ---------------------------------------------------------------------------
// Free-text history: as many dated entries as the doctor writes, in sanitized rich text.

model HistoryEntry {
  id         String    @id @default(uuid(7)) @db.Uuid
  patientId  String    @map("patient_id") @db.Uuid
  authorId   String?   @map("author_id") @db.Uuid
  editedById String?   @map("edited_by_id") @db.Uuid
  /// The date the history refers to (defaults to the day it was written).
  recordedOn DateTime  @map("recorded_on") @db.Date
  title      String?
  /// Sanitized on the server with a strict allow-list before it is stored.
  bodyHtml   String    @map("body_html")
  /// Plain-text copy of the body, for previews and search.
  bodyText   String    @map("body_text")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Removed entries are kept (medical record), just hidden.
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  patient  Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  author   StaffMember? @relation("HistoryAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  editedBy StaffMember? @relation("HistoryEditor", fields: [editedById], references: [id], onDelete: SetNull)

  @@index([patientId, recordedOn(sort: Desc), createdAt(sort: Desc)])
  @@map("history_entries")
}

// ---------------------------------------------------------------------------
// Appointments
// ---------------------------------------------------------------------------

enum AppointmentType {
  VISIT
  CALL
  SCAN
  LAB
  FOLLOW_UP
  OTHER

  @@map("appointment_type")
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("appointment_status")
}

/// Anything booked with a patient: a clinic visit, a phone call, a scan, a lab test…
model Appointment {
  id              String            @id @default(uuid(7)) @db.Uuid
  clinicId        String            @map("clinic_id") @db.Uuid
  patientId       String            @map("patient_id") @db.Uuid
  type            AppointmentType
  /// Optional short title, e.g. "Discuss scan results". The type gives the default wording.
  title           String?
  startsAt        DateTime          @map("starts_at") @db.Timestamptz(3)
  durationMinutes Int               @default(15) @map("duration_minutes")
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?
  assignedToId    String?           @map("assigned_to_id") @db.Uuid
  createdById     String?           @map("created_by_id") @db.Uuid
  /// When the status last changed away from SCHEDULED (done, cancelled or no-show).
  closedAt        DateTime?         @map("closed_at") @db.Timestamptz(3)
  cancelReason    String?           @map("cancel_reason")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic     Clinic       @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient    Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  assignedTo StaffMember? @relation("AppointmentAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  StaffMember? @relation("AppointmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clinicId, startsAt])
  @@index([patientId, startsAt(sort: Desc)])
  @@index([assignedToId, startsAt])
  @@map("appointments")
}

// ---------------------------------------------------------------------------
// Staff reminders (tasks): something to do by a time, optionally for a patient
// ---------------------------------------------------------------------------

enum TaskPriority {
  NORMAL
  HIGH

  @@map("task_priority")
}

/// A reminder for the team ("Call Mona about her lab results"), shown as "Reminders" in the app.
/// Separate from `Reminder`, which is a message sent to a patient.
model Task {
  id            String       @id @default(uuid(7)) @db.Uuid
  clinicId      String       @map("clinic_id") @db.Uuid
  title         String
  notes         String?
  dueAt         DateTime     @map("due_at") @db.Timestamptz(3)
  priority      TaskPriority @default(NORMAL)
  /// Who should do it; null means anyone on the team.
  assigneeId    String?      @map("assignee_id") @db.Uuid
  patientId     String?      @map("patient_id") @db.Uuid
  createdById   String?      @map("created_by_id") @db.Uuid
  completedAt   DateTime?    @map("completed_at") @db.Timestamptz(3)
  completedById String?      @map("completed_by_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic      Clinic       @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient     Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  assignee    StaffMember? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   StaffMember? @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  completedBy StaffMember? @relation("TaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([clinicId, completedAt, dueAt])
  @@index([assigneeId, completedAt, dueAt])
  @@index([patientId, dueAt])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Clinic finances: income and expenses beyond patient payments (owners only)
// ---------------------------------------------------------------------------

enum FinanceKind {
  INCOME
  EXPENSE

  @@map("finance_kind")
}

/// Expense or income categories. The clinic starts with a built-in set (with a `systemKey`) and
/// can rename, add or archive them.
model FinanceCategory {
  id         String      @id @default(uuid(7)) @db.Uuid
  clinicId   String      @map("clinic_id") @db.Uuid
  kind       FinanceKind
  nameEn     String      @map("name_en")
  nameAr     String      @map("name_ar")
  /// Set for the built-in categories, so they're created once per clinic.
  systemKey  String?     @map("system_key")
  sortOrder  Int         @default(0) @map("sort_order")
  archivedAt DateTime?   @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  clinic    Clinic             @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  entries   FinanceEntry[]
  recurring RecurringExpense[]

  @@unique([clinicId, systemKey])
  @@index([clinicId, kind])
  @@map("finance_categories")
}

/// Money in or out that isn't a patient payment: rent, salaries, supplies, a lab commission...
/// Never deleted; a mistake is voided with a reason, like patient payments.
model FinanceEntry {
  id              String        @id @default(uuid(7)) @db.Uuid
  clinicId        String        @map("clinic_id") @db.Uuid
  kind            FinanceKind
  categoryId      String        @map("category_id") @db.Uuid
  /// Money is stored as Decimal, never float.
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("EGP") @db.Char(3)
  method          PaymentMethod
  /// The day it was paid or received, in the clinic's time zone.
  occurredOn      DateTime      @map("occurred_on") @db.Date
  description     String
  /// Paid to (expense) or received from (income), e.g. the landlord or a supplier.
  counterparty    String?
  reference       String?
  notes           String?
  /// Set when generated from a recurring expense; one entry per recurring expense and month.
  recurringId     String?       @map("recurring_id") @db.Uuid
  recurrenceMonth DateTime?     @map("recurrence_month") @db.Date
  createdById     String?       @map("created_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  voidedAt        DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidReason      String?       @map("void_reason")
  voidedById      String?       @map("voided_by_id") @db.Uuid

  clinic    Clinic            @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  category  FinanceCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recurring RecurringExpense? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  createdBy StaffMember?      @relation("FinanceEntryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  voidedBy  StaffMember?      @relation("FinanceEntryVoider", fields: [voidedById], references: [id], onDelete: SetNull)
  receipts  FinanceReceipt[]

  @@unique([recurringId, recurrenceMonth])
  @@index([clinicId, occurredOn])
  @@map("finance_entries")
}

/// A photo or PDF of the receipt or invoice behind an entry.
model FinanceReceipt {
  id           String    @id @default(uuid(7)) @db.Uuid
  entryId      String    @map("entry_id") @db.Uuid
  uploadedById String?   @map("uploaded_by_id") @db.Uuid
  fileName     String    @map("file_name")
  mimeType     String    @map("mime_type")
  sizeBytes    Int       @map("size_bytes")
  sha256       String
  storageKey   String    @unique @map("storage_key")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  entry      FinanceEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  uploadedBy StaffMember? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([entryId])
  @@map("finance_receipts")
}

/// An expense that repeats every month (rent, salaries). Its entries are added automatically on
/// the chosen day; each one can still be edited or voided on its own.
model RecurringExpense {
  id                  String        @id @default(uuid(7)) @db.Uuid
  clinicId            String        @map("clinic_id") @db.Uuid
  categoryId          String        @map("category_id") @db.Uuid
  amount              Decimal       @db.Decimal(12, 2)
  currency            String        @default("EGP") @db.Char(3)
  method              PaymentMethod
  description         String
  counterparty        String?
  /// 1–28, so every month has the day.
  dayOfMonth          Int           @map("day_of_month")
  /// First and (optional) last day it can occur.
  startsOn            DateTime      @map("starts_on") @db.Date
  endsOn              DateTime?     @map("ends_on") @db.Date
  pausedAt            DateTime?     @map("paused_at") @db.Timestamptz(3)
  /// Every occurrence up to this day has been added (or deliberately skipped: paused or ended
  /// months). Null until the first run, which adds everything since `startsOn`.
  materializedThrough DateTime?     @map("materialized_through") @db.Date
  createdById         String?       @map("created_by_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic    Clinic          @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  category  FinanceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy StaffMember?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  entries   FinanceEntry[]

  @@index([clinicId])
  @@map("recurring_expenses")
}
