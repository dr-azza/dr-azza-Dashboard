{
  "extends": "@azza/tsconfig/node.json",
  "compilerOptions": {
    "target": "ES2023",
    "outDir": "dist",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "verbatimModuleSyntax": false,
    "strictPropertyInitialization": false,
    "types": ["node"]
