# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=4100
# Matches docker-compose.yml (dev-only credentials)
DATABASE_URL=postgresql://azzah:azzah_dev_only@localhost:5440/azzah?schema=public
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_HOURS=12
STORAGE_DIR=./storage
# Number of reverse proxies in front of the API (0 locally; 1 behind a single load balancer)
TRUST_PROXY_HOPS=0
# Password given to the seeded sample staff accounts (development only)
SEED_STAFF_PASSWORD=change-me-dev-only
# Separate database for integration tests (created once: docker compose exec postgres createdb -U azzah azzah_test)
TEST_DATABASE_URL=postgresql://azzah:azzah_dev_only@localhost:5440/azzah_test?schema=public
