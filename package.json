{
  "name": "azza",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@azza/web",
    "dev:api": "turbo run dev --filter=@azza/api",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "setup:catalyst": "node scripts/setup-catalyst.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.18.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsdown": "^0.23.1",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
